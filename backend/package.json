{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "API COMPLICE : opérations nécessitant un secret serveur (paiement simulé, suppression de compte, liens d'invitation).",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "seed:demo": "tsx --env-file-if-exists=.env src/scripts/seed-demo.ts"
  },
  "dependencies": {
    "@complice/shared": "*",
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^11.2.2",
    "@supabase/supabase-js": "^2.119.2",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
