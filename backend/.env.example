# Copier en backend/.env (jamais commité).
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

SUPABASE_URL=https://uecptmijcjwmzdebeugk.supabase.co
# Clé publique (peut être exposée) : sert à appeler la base sous l'identité de l'utilisateur, RLS appliquée.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_c3Edh33bG0YjD0pUzmbrlg_KR-lg_ZH
# Clé secrète serveur (Supabase > Project Settings > API Keys > Secret keys). NE JAMAIS la mettre dans l'app.
# Sans elle : contributions et suppression de compte répondent 503.
SUPABASE_SECRET_KEY=

APP_SCHEME=complice
# Origines web autorisées (CORS), séparées par des virgules. Vide pour l'app mobile native.
ALLOWED_ORIGINS=http://localhost:8081
PAYMENT_PROVIDER=simulated

# URL publique de l'API : base des liens envoyés par e-mail (/i/<jeton>, /e/<événement>).
APP_PUBLIC_URL=https://complice-api.onrender.com

# --- E-mails métier (invitations, ouverture de la capsule) via l'API Brevo ---
# Clé API Brevo (Brevo > SMTP & API > API Keys, préfixe xkeysib-). Secrète : ici et dans Render uniquement,
# jamais dans l'app mobile ni dans Git. Ce n'est PAS la clé SMTP utilisée par Supabase Auth.
# Vide : aucun e-mail métier ; l'invitation par e-mail répond 503 et rien n'est mis en file.
BREVO_API_KEY=
# Expéditeur validé dans Brevo (Senders & IP > Senders ; domaine authentifié SPF/DKIM recommandé).
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=COMPLICE
