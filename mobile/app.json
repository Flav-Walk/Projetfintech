{
  "expo": {
    "name": "Complice",
    "slug": "complice",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "complice",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF7F2",
    "ios": {
      "bundleIdentifier": "app.complice.mobile",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Complice utilise tes photos uniquement quand tu choisis d’en ajouter une (couverture, idée, capsule)."
      }
    },
    "android": {
      "package": "app.complice.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FFF7F2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF7F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Complice utilise tes photos uniquement quand tu choisis d’en ajouter une (couverture, idée, capsule).",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
