{
  "name": "complice",
  "private": true,
  "description": "COMPLICE — cagnottes gamifiées pour les cadeaux communs (monorepo)",
  "workspaces": [
    "mobile",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "test:db": "node --test \"supabase/tests/*.test.mjs\"",
    "db:bundle": "node supabase/scripts/bundle-migrations.mjs",
    "test:backend": "npm run test --workspace backend",
    "test:shared": "npm run test --workspace @complice/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:db && npm run test:shared && npm run test:backend",
    "mobile": "npm run start --workspace mobile",
    "backend": "npm run dev --workspace backend"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17"
  },
  "engines": {
    "node": ">=22.13"
  }
}
